# Session
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000

# Vercel Postgres (von Vercel automatisch gesetzt nach `vercel env pull`)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Brevo SMTP (https://app.brevo.com/settings/keys/smtp)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key
MAIL_FROM="Login App <no-reply@deine-domain.de>"
