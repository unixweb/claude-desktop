<%- include('partials/header', { title: 'Passwort erforderlich' }) %>
<div class="card">
  <h1>🔒 Passwort erforderlich</h1>
  <p>Dieser Link ist passwortgeschützt.</p>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="POST" action="/s/<%= slug %>">
    <label>
      Passwort
      <input type="password" name="password" required autofocus />
    </label>
    <button type="submit">Weiter</button>
  </form>
</div>
<%- include('partials/footer') %>
