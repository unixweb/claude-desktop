<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noai, noimageai" />
  <title><%= typeof title !== 'undefined' ? title : 'Login App' %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<%
  const layoutClass =
    typeof layout !== 'undefined' && layout === 'app' ? 'layout-app'
    : typeof layout !== 'undefined' && layout === 'landing' ? 'layout-landing'
    : 'layout-auth';
%>
<body class="<%= layoutClass %>">
  <% if (typeof layout !== 'undefined' && layout === 'app') { %>
    <nav class="navbar">
      <div class="navbar-inner">
        <a class="brand" href="/links">Shortlink</a>
        <div class="nav-links">
          <a href="/links">Meine Links</a>
          <a href="/tokens">API-Tokens</a>
          <% if (user && user.is_admin) { %>
            <a href="/admin" class="nav-admin">Admin</a>
          <% } %>
          <% if (user) { %>
            <span class="nav-email"><%= user.email %></span>
            <form method="POST" action="/logout" class="inline">
              <button type="submit" class="btn-link">Logout</button>
            </form>
          <% } %>
        </div>
      </div>
    </nav>
    <main class="container-wide">
  <% } else if (typeof layout !== 'undefined' && layout === 'landing') { %>
    <nav class="navbar navbar-transparent">
      <div class="navbar-inner">
        <a class="brand brand-light" href="/">mygopage</a>
        <div class="nav-links">
          <% if (user) { %>
            <a href="/links" class="nav-btn">Meine Links</a>
          <% } else { %>
            <a href="/login" class="nav-link-light">Anmelden</a>
            <a href="/register" class="nav-btn">Kostenlos starten</a>
          <% } %>
        </div>
      </div>
    </nav>
    <main>
  <% } else { %>
    <main class="container">
  <% } %>
  <% if (success && success.length) { %>
    <div class="flash flash-success"><%= success %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="flash flash-error"><%= error %></div>
  <% } %>
