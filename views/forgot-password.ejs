<%- include('partials/header', { title: 'Passwort zurücksetzen' }) %>
<div class="card">
  <h1>Passwort zurücksetzen</h1>
  <p>Gib deine E-Mail-Adresse ein. Wir senden dir einen Link zum Zurücksetzen.</p>
  <form method="POST" action="/forgot-password">
    <label>
      E-Mail
      <input type="email" name="email" required autofocus />
    </label>
    <button type="submit">Reset-Link senden</button>
  </form>
  <p class="links">
    <a href="/login">Zurück zur Anmeldung</a>
  </p>
</div>
<%- include('partials/footer') %>
