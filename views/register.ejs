<%- include('partials/header', { title: 'Registrieren' }) %>
<div class="card">
  <h1>Konto erstellen</h1>
  <% if (!registrationEnabled) { %>
    <div class="flash flash-error">
      Registrierungen sind aktuell deaktiviert. Bitte versuche es später erneut.
    </div>
    <p class="links"><a href="/login">Zur Anmeldung</a></p>
  <% } else { %>
    <form method="POST" action="/register" autocomplete="off">
      <input type="hidden" name="_t" value="<%= formTs %>" />
      <div class="hp-field" aria-hidden="true">
        <label>
          Website (bitte leer lassen)
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <label>
        E-Mail
        <input type="email" name="email" required autofocus autocomplete="email" />
      </label>
      <label>
        Passwort (min. 8 Zeichen)
        <input type="password" name="password" minlength="8" required autocomplete="new-password" />
      </label>
      <label>
        Passwort wiederholen
        <input type="password" name="passwordConfirm" minlength="8" required autocomplete="new-password" />
      </label>
      <label class="checkbox-row">
        <input type="checkbox" name="acceptTerms" value="1" required />
        <span>
          Ich habe die <a href="/agb" target="_blank">Nutzungsbedingungen</a> und die
          <a href="/datenschutz" target="_blank">Datenschutzerklärung</a> gelesen und akzeptiere sie.
        </span>
      </label>
      <button type="submit">Registrieren</button>
    </form>
    <p class="links">
      <a href="/login">Zurück zur Anmeldung</a>
    </p>
  <% } %>
</div>
<%- include('partials/footer') %>
