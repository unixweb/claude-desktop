<%- include('partials/header', { title: 'Registrieren' }) %>
<div class="card">
  <h1>Konto erstellen</h1>
  <% if (!registrationEnabled) { %>
    <div class="flash flash-error">
      Registrierungen sind aktuell deaktiviert. Bitte versuche es später erneut.
    </div>
    <p class="links"><a href="/login">Zur Anmeldung</a></p>
  <% } else { %>
    <form method="POST" action="/register">
      <label>
        E-Mail
        <input type="email" name="email" required autofocus />
      </label>
      <label>
        Passwort (min. 8 Zeichen)
        <input type="password" name="password" minlength="8" required />
      </label>
      <label>
        Passwort wiederholen
        <input type="password" name="passwordConfirm" minlength="8" required />
      </label>
      <button type="submit">Registrieren</button>
    </form>
    <p class="links">
      <a href="/login">Zurück zur Anmeldung</a>
    </p>
  <% } %>
</div>
<%- include('partials/footer') %>
